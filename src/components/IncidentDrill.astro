---
interface Choice {
	label: string;
	next: string;
	note?: string;
	/** Minutes of user impact (incident mode) or points of wasted time/trust (decision mode) this choice adds. */
	cost?: number;
}
interface Node {
	text: string;
	choices?: Choice[];
	end?: 'good' | 'ok' | 'bad';
}
interface Props {
	id: string;
	title: string;
	start: string;
	nodes: Record<string, Node>;
	/** "incident" (default) scores user impact in minutes; "decision" is for scenarios that aren't outages. */
	mode?: 'incident' | 'decision';
}

const { id, title, start, nodes, mode = 'incident' } = Astro.props;
const label = mode === 'incident' ? 'User impact' : 'Cost of detours';
const unit = mode === 'incident' ? 'min' : 'pts';
---

<section class="drill not-content" data-drill={id} data-start={start} data-nodes={JSON.stringify(nodes)} data-mode={mode} data-label={label} data-unit={unit}>
	<header class="drill__head">
		<span class="drill__badge">{mode === 'incident' ? '🔥 Incident drill' : '🧭 Decision drill'}</span>
		<strong>{title}</strong>
		<span class="drill__impact" aria-live="polite">{label}: 0 {unit}</span>
	</header>
	<ol class="drill__log"></ol>
	<div class="drill__stage">
		<p class="drill__text"></p>
		<div class="drill__choices"></div>
	</div>
	<button type="button" class="drill__restart" hidden>Run the drill again</button>
</section>

<script>
	type Choice = { label: string; next: string; note?: string; cost?: number };
	type Node = { text: string; choices?: Choice[]; end?: 'good' | 'ok' | 'bad' };

	const endings = {
		incident: {
			good: '🟢 Incident resolved well.',
			ok: '🟡 Resolved, with avoidable damage.',
			bad: '🔴 This went badly. Replay and try another path.',
		},
		decision: {
			good: '🟢 Well handled.',
			ok: '🟡 You got there, with avoidable detours.',
			bad: '🔴 This went badly. Replay and try another path.',
		},
	};

	for (const drill of document.querySelectorAll<HTMLElement>('[data-drill]')) {
		const nodes: Record<string, Node> = JSON.parse(drill.dataset.nodes!);
		const log = drill.querySelector<HTMLOListElement>('.drill__log')!;
		const text = drill.querySelector<HTMLElement>('.drill__text')!;
		const choices = drill.querySelector<HTMLElement>('.drill__choices')!;
		const impact = drill.querySelector<HTMLElement>('.drill__impact')!;
		const restart = drill.querySelector<HTMLButtonElement>('.drill__restart')!;
		const mode = drill.dataset.mode === 'decision' ? 'decision' : 'incident';
		const label = drill.dataset.label!;
		const unit = drill.dataset.unit!;
		let minutes = 0;

		const show = (key: string) => {
			const node = nodes[key];
			text.textContent = node.text;
			choices.replaceChildren();
			if (node.end) {
				const p = document.createElement('p');
				p.className = `drill__end drill__end--${node.end}`;
				p.textContent = `${endings[mode][node.end]} Total ${label.toLowerCase()}: ${minutes} ${unit}.`;
				choices.append(p);
				restart.hidden = false;
				return;
			}
			for (const choice of node.choices ?? []) {
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'drill__choice';
				btn.textContent = choice.label;
				btn.addEventListener('click', () => {
					minutes += choice.cost ?? 0;
					impact.textContent = `${label}: ${minutes} ${unit}`;
					const li = document.createElement('li');
					li.innerHTML = '<strong></strong><span></span>';
					li.querySelector('strong')!.textContent = `You: ${choice.label}`;
					li.querySelector('span')!.textContent = choice.note ? ` → ${choice.note}` : '';
					log.append(li);
					show(choice.next);
				});
				choices.append(btn);
			}
		};

		restart.addEventListener('click', () => {
			minutes = 0;
			impact.textContent = `${label}: 0 ${unit}`;
			log.replaceChildren();
			restart.hidden = true;
			show(drill.dataset.start!);
		});

		show(drill.dataset.start!);
	}
</script>
