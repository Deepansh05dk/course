---
---

<section class="judge not-content" data-judge>
	<p class="judge__badge">⚖️ Judge calibration calculator</p>
	<p class="judge__intro">
		Step 1: on a labelled calibration set, count how the judge's verdicts compare with human labels. Step 2: enter the pass
		rate the judge reports on new, unlabelled traffic.
	</p>
	<div class="judge__grid">
		<span></span><strong>Judge: pass</strong><strong>Judge: fail</strong>
		<strong>Human: pass</strong>
		<label>TP <input type="number" name="tp" min="0" value="76" /></label>
		<label>FN <input type="number" name="fn" min="0" value="4" /></label>
		<strong>Human: fail</strong>
		<label>FP <input type="number" name="fp" min="0" value="5" /></label>
		<label>TN <input type="number" name="tn" min="0" value="15" /></label>
	</div>
	<label class="judge__obs">Pass rate reported by the judge on production traffic: <output name="obsOut"></output>
		<input type="range" name="obs" min="0" max="100" value="81" />
	</label>
	<div class="judge__out">
		<div><span>TPR (passes recognised)</span><strong data-o="tpr"></strong></div>
		<div><span>TNR (failures caught)</span><strong data-o="tnr"></strong></div>
		<div><span>Estimated true pass rate</span><strong data-o="true"></strong></div>
	</div>
	<p class="judge__verdict" aria-live="polite"></p>
</section>

<script>
	for (const box of document.querySelectorAll<HTMLElement>('[data-judge]')) {
		const num = (n: string) => Math.max(0, Number(box.querySelector<HTMLInputElement>(`[name="${n}"]`)!.value) || 0);
		const out = (k: string) => box.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
		const pct = (x: number) => `${(x * 100).toFixed(1)}%`;
		const update = () => {
			const [tp, fn, fp, tn] = ['tp', 'fn', 'fp', 'tn'].map(num);
			const obs = num('obs') / 100;
			box.querySelector<HTMLOutputElement>('[name="obsOut"]')!.value = pct(obs);
			const tpr = tp + fn ? tp / (tp + fn) : NaN;
			const tnr = tn + fp ? tn / (tn + fp) : NaN;
			out('tpr').textContent = Number.isNaN(tpr) ? 'n/a' : pct(tpr);
			out('tnr').textContent = Number.isNaN(tnr) ? 'n/a' : pct(tnr);
			const denom = tpr + tnr - 1;
			const verdict = box.querySelector<HTMLElement>('.judge__verdict')!;
			if (!(denom > 0.2)) {
				out('true').textContent = '—';
				verdict.textContent =
					denom > 0
						? `🔴 This judge is barely better than chance (TPR + TNR − 1 = ${denom.toFixed(2)}), so any corrected estimate is unstable. Fix the judge before trusting its numbers.`
						: '🔴 This judge is no better than a coin flip (TPR + TNR ≤ 1). Fix the judge before trusting any number it produces.';
				return;
			}
			const corrected = Math.min(1, Math.max(0, (obs + tnr - 1) / denom));
			out('true').textContent = pct(corrected);
			const fails = tn + fp;
			verdict.textContent =
				fails < 20
					? `🟡 Only ${fails} human-labelled failures in the calibration set, so the TNR estimate is very noisy. Label more failures.`
					: tnr < 0.8
						? `🟡 The judge misses ${pct(1 - tnr)} of real failures, so its raw pass rate is optimistic. Report the corrected rate, and improve the judge prompt.`
						: `🟢 TPR and TNR are both reasonable. The corrected estimate (${pct(corrected)}) is what you report, not the raw ${pct(obs)}.`;
		};
		box.addEventListener('input', update);
		update();
	}
</script>
