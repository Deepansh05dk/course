---
---

<section class="acost not-content" data-acost>
	<p class="acost__badge">📈 Agent cost simulator: why long agent runs get expensive</p>
	<div class="acost__controls">
		<label>Turns (model calls): <output name="turnsOut"></output>
			<input type="range" name="turns" min="1" max="40" value="15" />
		</label>
		<label>Tokens added per turn (tool results + model output): <output name="growOut"></output>
			<input type="range" name="grow" min="200" max="20000" step="200" value="4000" />
		</label>
		<label>Stable prefix (system prompt + tool definitions): <output name="prefixOut"></output>
			<input type="range" name="prefix" min="1000" max="40000" step="1000" value="8000" />
		</label>
		<label>Input price ($ per M tokens): <output name="priceOut"></output>
			<input type="range" name="price" min="0.1" max="10" step="0.1" value="4" />
		</label>
		<label class="acost__check"><input type="checkbox" name="cache" /> Prompt caching (cached tokens at ~10% of the price)</label>
		<label class="acost__check"><input type="checkbox" name="compact" /> Compaction: when history passes 40K tokens, summarize it to 5K</label>
	</div>
	<svg class="acost__chart" viewBox="0 0 400 140" preserveAspectRatio="none" role="img" aria-label="Input tokens per turn"></svg>
	<p class="acost__legend"><i class="acost__k acost__k--prefix"></i>prefix <i class="acost__k acost__k--hist"></i>history <i class="acost__k acost__k--cached"></i>served from cache</p>
	<div class="acost__out">
		<div><span>Total input tokens</span><strong data-o="tokens"></strong></div>
		<div><span>Input cost for this task</span><strong data-o="cost"></strong></div>
		<div><span>Last turn's input</span><strong data-o="last"></strong></div>
	</div>
	<p class="acost__note" aria-live="polite"></p>
</section>

<script>
	const fmtK = (n: number) => (n >= 1e6 ? `${(n / 1e6).toFixed(2)}M` : n >= 1000 ? `${(n / 1000).toFixed(0)}K` : String(Math.round(n)));

	for (const box of document.querySelectorAll<HTMLElement>('[data-acost]')) {
		const num = (n: string) => Number(box.querySelector<HTMLInputElement>(`[name="${n}"]`)!.value);
		const on = (n: string) => box.querySelector<HTMLInputElement>(`[name="${n}"]`)!.checked;
		const setOut = (n: string, v: string) => (box.querySelector<HTMLOutputElement>(`[name="${n}Out"]`)!.value = v);
		const svg = box.querySelector<SVGSVGElement>('.acost__chart')!;

		const render = () => {
			const turns = num('turns');
			const grow = num('grow');
			const prefix = num('prefix');
			const price = num('price');
			setOut('turns', String(turns));
			setOut('grow', fmtK(grow));
			setOut('prefix', fmtK(prefix));
			setOut('price', `$${price.toFixed(1)}`);

			// Each turn re-sends prefix + all history so far. With caching, everything that was
			// already sent last turn is a cache read; only the new part is full price.
			let history = 0;
			let prevSent = 0;
			let totalTokens = 0;
			let cost = 0;
			const bars: { prefix: number; hist: number; cached: number }[] = [];
			for (let t = 0; t < turns; t++) {
				let compacted = false;
				if (on('compact') && history > 40000) {
					history = 5000;
					compacted = true;
				}
				const sent = prefix + history;
				// After a compaction the history is new text, so only the stable prefix is still cached.
				const cached = !on('cache') || t === 0 ? 0 : compacted ? prefix : Math.min(prevSent, sent);
				totalTokens += sent;
				cost += ((sent - cached) * price + cached * price * 0.1) / 1e6;
				bars.push({ prefix, hist: history, cached });
				prevSent = sent;
				history += grow;
			}

			const max = Math.max(...bars.map((b) => b.prefix + b.hist), 1);
			const w = 400 / turns;
			svg.innerHTML = bars
				.map((b, i) => {
					const x = i * w + w * 0.1;
					const bw = w * 0.8;
					const hp = (b.prefix / max) * 130;
					const hh = (b.hist / max) * 130;
					const hc = (b.cached / max) * 130;
					return (
						`<rect x="${x}" y="${140 - hp}" width="${bw}" height="${hp}" class="acost__prefix"/>` +
						`<rect x="${x}" y="${140 - hp - hh}" width="${bw}" height="${hh}" class="acost__hist"/>` +
						(hc ? `<rect x="${x}" y="${140 - hc}" width="${bw}" height="${hc}" class="acost__cached"/>` : '')
					);
				})
				.join('');

			box.querySelector('[data-o="tokens"]')!.textContent = fmtK(totalTokens);
			box.querySelector('[data-o="cost"]')!.textContent = `$${cost.toFixed(cost < 1 ? 3 : 2)}`;
			box.querySelector('[data-o="last"]')!.textContent = fmtK(bars[bars.length - 1].prefix + bars[bars.length - 1].hist);
			const naive = turns * prefix + (grow * turns * (turns - 1)) / 2;
			box.querySelector('.acost__note')!.textContent =
				!on('cache') && !on('compact')
					? `Input grows every turn because the whole history is re-sent: ${turns} turns cost ${fmtK(naive)} input tokens, not ${fmtK(prefix + grow * turns)}. Now try caching and compaction.`
					: `With ${[on('cache') && 'caching', on('compact') && 'compaction'].filter(Boolean).join(' and ')}, the same task costs $${cost.toFixed(3)} instead of $${((naive * price) / 1e6).toFixed(3)}.`;
		};
		box.addEventListener('input', render);
		render();
	}
</script>
